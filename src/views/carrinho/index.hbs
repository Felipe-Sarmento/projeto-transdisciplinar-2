<section>
  <h1 class="text-2xl font-extrabold text-stone-800">Seu carrinho</h1>

  {{#if lines.length}}
    <div class="mt-6 grid gap-6 lg:grid-cols-[2fr_1fr]">
      <div class="card divide-y divide-stone-100">
        {{#each lines}}
          <div class="flex flex-wrap items-center gap-4 p-4">
            <img class="h-16 w-16 rounded-lg object-cover" src="{{this.imageUrl}}" alt="{{this.name}}" />
            <div class="min-w-40 flex-1">
              <p class="font-semibold text-stone-800">{{this.name}}</p>
              <p class="text-sm text-stone-500">R$ {{this.unitPrice}} cada</p>
            </div>

            <form method="post" action="/carrinho/itens/{{this.productId}}" class="flex items-center gap-2">
              <label class="sr-only" for="qtd-{{this.productId}}">Quantidade</label>
              <input
                class="input w-16 text-center"
                id="qtd-{{this.productId}}"
                name="quantity"
                type="number"
                min="1"
                max="99"
                value="{{this.quantity}}"
              />
              <button class="btn btn-secondary" type="submit">Atualizar</button>
            </form>

            <p class="w-24 text-right font-bold text-stone-800">R$ {{this.lineTotal}}</p>

            <form method="post" action="/carrinho/itens/{{this.productId}}/remover">
              <button class="btn btn-danger" type="submit">Remover</button>
            </form>
          </div>
        {{/each}}
      </div>

      <aside class="card h-fit p-6">
        <h2 class="text-lg font-bold text-stone-800">Finalizar pedido</h2>

        {{#if erro}}<p class="alert alert-error mt-4" role="alert">{{erro}}</p>{{/if}}

        <div class="mt-4 flex justify-between text-sm text-stone-600">
          <span>Itens</span>
          <span>{{count}}</span>
        </div>
        <div class="mt-2 flex justify-between border-t border-stone-100 pt-2 text-lg font-extrabold text-stone-800">
          <span>Total</span>
          <span>R$ {{subtotal}}</span>
        </div>

        <form method="post" action="/carrinho/confirmar" class="mt-4 space-y-3">
          <div>
            <label class="field-label" for="customerName">Nome</label>
            <input class="input mt-1" id="customerName" name="customerName" autocomplete="name" required />
          </div>
          <div>
            <label class="field-label" for="deliveryAddress">Endereço de entrega</label>
            <input class="input mt-1" id="deliveryAddress" name="deliveryAddress" placeholder="Rua, número, bairro, cidade" required />
          </div>
          <button class="btn btn-primary w-full" type="submit">Confirmar pedido</button>
        </form>

        <a class="btn btn-ghost mt-2 w-full" href="/">Continuar comprando</a>
      </aside>
    </div>
  {{else}}
    <div class="card mt-6 flex flex-col items-center gap-2 px-6 py-16 text-center">
      <span class="text-4xl" aria-hidden="true">🛒</span>
      <p class="font-semibold text-stone-700">Seu carrinho está vazio</p>
      <p class="text-sm text-stone-500">Que tal escolher alguns cupcakes?</p>
      <a class="btn btn-primary mt-2" href="/">Ver catálogo</a>
    </div>
  {{/if}}
</section>
