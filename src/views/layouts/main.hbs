<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Cupcake Gourmet — cupcakes artesanais gourmet, feitos com carinho."
    />
    <meta name="theme-color" content="#e11d48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{{title}} · Cupcake Gourmet</title>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="flex min-h-screen flex-col bg-amber-50 text-stone-800 antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-rose-600 focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
      href="#conteudo"
    >Pular para o conteúdo</a>

    {{> header}}

    <main id="conteudo" class="container-page flex-1 py-8">
      {{{body}}}
    </main>

    {{> footer}}

    {{> toast}}

    <script src="/js/app.js" defer></script>
  </body>
</html>
