<header class="bg-rose-500 text-white shadow">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a class="text-xl font-bold" href="/">Cupcake Gourmet</a>

    <nav class="text-sm">
      {{#if currentUser}}
        <span class="font-medium">{{currentUser.name}}</span>
        <form method="post" action="/logout" class="ml-3 inline">
          <button type="submit" class="underline">Sair</button>
        </form>
      {{else}}
        <a class="underline" href="/login">Entrar</a>
      {{/if}}
    </nav>
  </div>
</header>
