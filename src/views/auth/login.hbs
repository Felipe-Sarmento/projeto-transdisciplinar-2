<section class="mx-auto max-w-sm">
  <div class="card p-8">
    <div class="flex flex-col items-center text-center">
      <span class="text-4xl" aria-hidden="true">🧁</span>
      <h1 class="mt-2 text-2xl font-extrabold text-stone-800">Entrar</h1>
      <p class="mt-1 text-sm text-stone-500">Acesso restrito à administração.</p>
    </div>

    {{#if error}}
      <p class="alert alert-error mt-6" role="alert">{{error}}</p>
    {{/if}}

    <form method="post" action="/login" class="mt-6 space-y-4">
      <div>
        <label class="field-label" for="email">E-mail</label>
        <input
          class="input mt-1"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          autofocus
          required
        />
      </div>

      <div>
        <label class="field-label" for="password">Senha</label>
        <input
          class="input mt-1"
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          minlength="8"
          required
        />
      </div>

      <button class="btn btn-primary w-full" type="submit">Entrar</button>
    </form>
  </div>
</section>
