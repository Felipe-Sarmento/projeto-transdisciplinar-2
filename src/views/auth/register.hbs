<section class="mx-auto max-w-sm">
  <div class="card p-8">
    <div class="flex flex-col items-center text-center">
      <span class="text-4xl" aria-hidden="true">🧁</span>
      <h1 class="mt-2 text-2xl font-extrabold text-stone-800">Criar conta</h1>
      <p class="mt-1 text-sm text-stone-500">Cadastre-se para finalizar seus pedidos.</p>
    </div>

    {{#if error}}
      <p class="alert alert-error mt-6" role="alert">{{error}}</p>
    {{/if}}

    <form method="post" action="/cadastro" class="mt-6 space-y-4">
      <div>
        <label class="field-label" for="name">Nome</label>
        <input
          class="input mt-1"
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          minlength="2"
          autofocus
          required
        />
      </div>

      <div>
        <label class="field-label" for="email">E-mail</label>
        <input
          class="input mt-1"
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
        />
      </div>

      <div>
        <label class="field-label" for="password">Senha</label>
        <input
          class="input mt-1"
          type="password"
          id="password"
          name="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </div>

      <button class="btn btn-primary w-full" type="submit">Criar conta</button>
    </form>

    <p class="mt-4 text-center text-sm text-stone-500">
      Já tem conta?
      <a class="font-semibold text-rose-600 hover:underline" href="/login">Entrar</a>
    </p>
  </div>
</section>
