<section>
  {{> admin-nav}}

  <div class="card p-6 sm:p-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-2xl font-extrabold text-stone-800">Produtos</h1>
      <a class="btn btn-primary" href="/admin/produtos/novo">+ Novo produto</a>
    </div>

    {{#if ok}}<p class="alert alert-success mt-4" role="status">{{ok}}</p>{{/if}}
    {{#if erro}}<p class="alert alert-error mt-4" role="alert">{{erro}}</p>{{/if}}

    {{#if products.length}}
      <div class="mt-6 overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Categoria</th>
              <th>Preço</th>
              <th>Estoque</th>
              <th>Situação</th>
              <th class="text-right">Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each products}}
              <tr>
                <td class="font-semibold text-stone-800">{{this.name}}</td>
                <td class="text-stone-500">{{this.categoryName}}</td>
                <td>R$ {{this.price}}</td>
                <td>
                  {{#if (eq this.availableQuantity 0)}}
                    <span class="badge badge-out">0</span>
                  {{else}}
                    {{this.availableQuantity}}
                  {{/if}}
                </td>
                <td>
                  {{#if this.active}}
                    <span class="badge badge-active">Ativo</span>
                  {{else}}
                    <span class="badge badge-inactive">Inativo</span>
                  {{/if}}
                </td>
                <td>
                  <div class="flex items-center justify-end gap-2">
                    <a class="btn btn-ghost" href="/admin/produtos/{{this.id}}/editar">Editar</a>
                    <form method="post" action="/admin/produtos/{{this.id}}/ativar">
                      <button class="btn btn-secondary" type="submit">
                        {{#if this.active}}Desativar{{else}}Ativar{{/if}}
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="mt-6 rounded-lg border border-dashed border-stone-300 px-6 py-12 text-center">
        <p class="font-semibold text-stone-700">Nenhum produto cadastrado</p>
        <p class="mt-1 text-sm text-stone-500">Comece adicionando o primeiro cupcake.</p>
      </div>
    {{/if}}
  </div>
</section>
