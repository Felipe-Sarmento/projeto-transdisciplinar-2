<section>
  {{> admin-nav}}

  <div class="card mx-auto max-w-2xl p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold text-stone-800">{{title}}</h1>

    <form method="post" action="{{action}}" class="mt-6 space-y-5">
      <div>
        <label class="field-label" for="name">Nome <span class="text-rose-600">*</span></label>
        <input class="input mt-1" id="name" name="name" value="{{product.name}}" required />
      </div>

      <div>
        <label class="field-label" for="description">Descrição <span class="text-rose-600">*</span></label>
        <textarea class="input mt-1" id="description" name="description" rows="3" required>{{product.description}}</textarea>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for="price">Preço (R$) <span class="text-rose-600">*</span></label>
          <input class="input mt-1" id="price" name="price" type="number" step="0.01" min="0.01" value="{{product.price}}" required />
        </div>

        <div>
          <label class="field-label" for="availableQuantity">Quantidade disponível <span class="text-rose-600">*</span></label>
          <input class="input mt-1" id="availableQuantity" name="availableQuantity" type="number" min="0" value="{{product.availableQuantity}}" required />
        </div>
      </div>

      <div>
        <label class="field-label" for="imageUrl">Imagem (URL)</label>
        <input class="input mt-1" id="imageUrl" name="imageUrl" type="url" value="{{product.imageUrl}}" placeholder="https://..." />
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for="categoryId">Categoria <span class="text-rose-600">*</span></label>
          <select class="input mt-1" id="categoryId" name="categoryId" required>
            {{#each categories}}
              <option value="{{this.id}}" {{#if (eq this.id ../product.categoryId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label class="field-label" for="active">Situação</label>
          <select class="input mt-1" id="active" name="active">
            <option value="true" {{#if product.active}}selected{{/if}}>Ativo</option>
            <option value="false" {{#if product}}{{#unless product.active}}selected{{/unless}}{{/if}}>Inativo</option>
          </select>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button class="btn btn-primary" type="submit">Salvar</button>
        <a class="btn btn-secondary" href="/admin/produtos">Cancelar</a>
      </div>
    </form>
  </div>
</section>
