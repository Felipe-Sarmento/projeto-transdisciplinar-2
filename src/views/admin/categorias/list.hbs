<section>
  {{> admin-nav}}

  <div class="card mx-auto max-w-2xl p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold text-stone-800">Categorias</h1>

    {{#if ok}}<p class="alert alert-success mt-4" role="status">{{ok}}</p>{{/if}}
    {{#if erro}}<p class="alert alert-error mt-4" role="alert">{{erro}}</p>{{/if}}

    <form method="post" action="/admin/categorias" class="mt-6 flex flex-col gap-2 sm:flex-row">
      <label class="sr-only" for="nova-categoria">Nova categoria</label>
      <input
        class="input flex-1"
        id="nova-categoria"
        name="name"
        placeholder="Nova categoria"
        required
      />
      <button class="btn btn-primary" type="submit">Adicionar</button>
    </form>

    {{#if categories.length}}
      <ul class="mt-6 divide-y divide-stone-100">
        {{#each categories}}
          <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center">
            <form method="post" action="/admin/categorias/{{this.id}}" class="flex flex-1 gap-2">
              <label class="sr-only" for="categoria-{{this.id}}">Nome da categoria</label>
              <input
                class="input flex-1"
                id="categoria-{{this.id}}"
                name="name"
                value="{{this.name}}"
                required
              />
              <button class="btn btn-secondary" type="submit">Salvar</button>
            </form>
            <form method="post" action="/admin/categorias/{{this.id}}/excluir">
              <button class="btn btn-danger" type="submit">Excluir</button>
            </form>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <div class="mt-6 rounded-lg border border-dashed border-stone-300 px-6 py-12 text-center">
        <p class="font-semibold text-stone-700">Nenhuma categoria cadastrada</p>
        <p class="mt-1 text-sm text-stone-500">Adicione a primeira categoria acima.</p>
      </div>
    {{/if}}
  </div>
</section>
