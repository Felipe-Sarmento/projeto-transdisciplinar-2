<section>
  {{> admin-nav}}

  <div class="card p-6 sm:p-8">
    <h1 class="text-2xl font-extrabold text-stone-800">Pedidos</h1>

    {{#if ok}}<p class="alert alert-success mt-4" role="status">{{ok}}</p>{{/if}}
    {{#if erro}}<p class="alert alert-error mt-4" role="alert">{{erro}}</p>{{/if}}

    {{#if orders.length}}
      <div class="mt-6 overflow-x-auto">
        <table class="table-base">
          <thead>
            <tr>
              <th>#</th>
              <th>Cliente</th>
              <th>Endereço</th>
              <th>Data</th>
              <th>Itens</th>
              <th>Total</th>
              <th>Status</th>
              <th class="text-right">Ações</th>
            </tr>
          </thead>
          <tbody>
            {{#each orders}}
              <tr>
                <td class="font-semibold text-stone-800">#{{this.id}}</td>
                <td>{{this.customerName}}</td>
                <td class="text-stone-500">{{this.deliveryAddress}}</td>
                <td class="text-stone-500">{{date this.createdAt}}</td>
                <td>{{this.itemsCount}}</td>
                <td>R$ {{this.total}}</td>
                <td><span class="badge {{statusClass this.status}}">{{statusLabel this.status}}</span></td>
                <td>
                  <div class="flex items-center justify-end gap-2">
                    {{#if (eq this.status 'PENDENTE')}}
                      <form method="post" action="/admin/pedidos/{{this.id}}/status">
                        <input type="hidden" name="status" value="PAGAMENTO_REALIZADO" />
                        <button class="btn btn-primary" type="submit">Confirmar</button>
                      </form>
                      <form method="post" action="/admin/pedidos/{{this.id}}/status">
                        <input type="hidden" name="status" value="CANCELADO" />
                        <button class="btn btn-danger" type="submit">Cancelar</button>
                      </form>
                    {{/if}}
                    <a class="btn btn-ghost" href="/pedido/{{this.id}}">Ver</a>
                  </div>
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="mt-6 rounded-lg border border-dashed border-stone-300 px-6 py-12 text-center">
        <p class="font-semibold text-stone-700">Nenhum pedido ainda</p>
        <p class="mt-1 text-sm text-stone-500">Os pedidos do checkout aparecem aqui.</p>
      </div>
    {{/if}}
  </div>
</section>
