<section>
  <nav class="mb-4 text-sm text-stone-500" aria-label="Trilha de navegação">
    <a class="transition hover:text-rose-600" href="/">Catálogo</a>
    <span aria-hidden="true"> / </span>
    <span class="font-medium text-stone-700">{{product.name}}</span>
  </nav>

  <div class="card grid gap-8 overflow-hidden p-6 md:grid-cols-2 md:p-8">
    <div class="overflow-hidden rounded-xl bg-stone-100">
      <img
        class="aspect-[4/3] h-full w-full object-cover"
        src="{{product.imageUrl}}"
        alt="{{product.name}}"
      />
    </div>

    <div class="flex flex-col">
      <p class="text-xs font-semibold uppercase tracking-wide text-stone-400">{{product.categoryName}}</p>
      <div class="mt-1 flex flex-wrap items-center gap-3">
        <h1 class="text-2xl font-extrabold text-stone-800 sm:text-3xl">{{product.name}}</h1>
        {{#if (eq product.availableQuantity 0)}}
          <span class="badge badge-out">Esgotado</span>
        {{/if}}
      </div>

      <p class="mt-4 leading-relaxed text-stone-600">{{product.description}}</p>

      <p class="mt-6 text-3xl font-extrabold text-rose-600">R$ {{product.price}}</p>

      {{#if (eq product.availableQuantity 0)}}
        <p class="alert alert-error mt-4">Produto esgotado no momento.</p>
      {{/if}}

      <div class="mt-6">
        <a class="btn btn-secondary" href="/">← Voltar ao catálogo</a>
      </div>
    </div>
  </div>
</section>
