<section class="mx-auto max-w-2xl rounded-lg bg-white p-8 shadow-sm">
  <img class="h-56 w-full rounded object-cover" src="{{product.imageUrl}}" alt="{{product.name}}" />

  <div class="mt-4 flex items-center gap-3">
    <h2 class="text-2xl font-semibold text-rose-600">{{product.name}}</h2>
    {{#if (eq product.availableQuantity 0)}}
      <span class="rounded bg-stone-200 px-2 py-0.5 text-xs text-stone-600">Esgotado</span>
    {{/if}}
  </div>

  <p class="mt-1 text-sm text-stone-500">{{product.categoryName}}</p>
  <p class="mt-4 text-stone-700">{{product.description}}</p>
  <p class="mt-4 text-xl font-bold text-rose-600">R$ {{product.price}}</p>

  {{#if (eq product.availableQuantity 0)}}
    <p class="mt-4 rounded bg-amber-50 px-3 py-2 text-sm text-amber-700">
      Produto esgotado no momento.
    </p>
  {{/if}}

  <a class="mt-6 inline-block text-rose-600 underline" href="/">Voltar ao catálogo</a>
</section>
